{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "popboxstudio-web",
  "main": "worker.mjs",
  "compatibility_date": "2026-11-25",
  "compatibility_flags": ["nodejs_compat"],
  "keep_names": false,
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": ["/kuji-reveal.mp4"]
  },
  "images": { "binding": "IMAGES" },
  "kv_namespaces": [{ "binding": "NEXT_INC_CACHE_KV", "id": "1b3c1197001f4ea69b58f4ea1361de93" }],
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "popboxstudio-web" }],
  "durable_objects": {
    "bindings": [
      { "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" },
      { "name": "NEXT_TAG_CACHE_DO_SHARDED", "class_name": "DOShardedTagCache" },
      { "name": "POPBOX_NEXT_RENDERER", "class_name": "PopBoxNextRenderer" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["DOQueueHandler", "DOShardedTagCache"] },
    { "tag": "renderer-v2", "new_sqlite_classes": ["PopBoxNextRenderer"] }
  ],
  "vars": {
    "POPBOX_PREVIEW_READ_ONLY": "false",
    "NEXT_INC_CACHE_KV_PREFIX": "popboxstudio-production"
  },
  "keep_vars": true,
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "invocation_logs": false },
    "traces": { "enabled": false }
  }
}
